# ====================================================================
# AtmosIQ - Environment Configuration Example
# ====================================================================
# Copy this file to .env and provide your Firebase project credentials.
# Note: Client configuration values are public identifiers, but secure
# Firestore Security Rules must be configured in your Firebase Console.
# If these variables are left empty, AtmosIQ will gracefully run in
# Local-Only Mode with full SQLite functionality and indicate
# "Cloud Sync: Unconfigured" in the Cloud Sync screen.
# ====================================================================

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-atmosiq-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-atmosiq-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-atmosiq-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
